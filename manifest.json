{
  "manifest_version": 3,
  "name": "Kinopoisk Watch",
  "version": "1.0.0",
  "description": "Добавляет на kinopoisk.ru кнопку «Смотреть», которая открывает тот же фильм на выбранном сайте.",
  "permissions": ["storage"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kinopoisk.ru/*", "https://kinopoisk.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Kinopoisk Watch: настройки",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
